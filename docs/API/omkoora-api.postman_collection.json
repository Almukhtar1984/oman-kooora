                "query": "mutation UpdateTransfer($id: ID!, $content: contentTransfer!) {\n  updateTransfer(id: $id, content: $content) { status }\n}",
                "variables": "{\n  \"id\": \"\",\n  \"content\": {\n    \"status\": \"accepted\"\n  }\n}"
              }
            },
            "description": "status: accepted | rejected."
          }
        }
