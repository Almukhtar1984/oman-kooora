{
  "info": {
    "name": "Tomoh / omkooora API",
    "description": "GraphQL API for the Tomoh (omkooora) football-management platform.\n\nOne endpoint serves every operation: POST {{baseUrl}}/graphql.\n\nHow to use:\n1. Import this collection AND `omkoora-api.postman_environment.json`, then select the environment.\n2. Fill `email` / `password` (and the sample ids) in the environment.\n3. Run **Auth > Login** first — it saves the access token to the `token` variable automatically.\n4. Every request auto-attaches the required headers (Authorization, apollo-require-preflight, x-apollo-operation-name) via a collection pre-request script.\n\nSee `README.md` and `schema.graphql` (same folder) for the full contract. Fields marked @auth need a token; the rest are public.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach the headers every /graphql request needs.",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'apollo-require-preflight', value: 'true' });",
          "var op = (pm.info.requestName || 'Operation').replace(/[^A-Za-z0-9_]/g, '');",
          "pm.request.headers.upsert({ key: 'x-apollo-operation-name', value: op || 'Operation' });",
          "var token = pm.collectionVariables.get('token') || pm.environment.get('token');",
          "if (token) { pm.request.headers.upsert({ key: 'Authorization', value: token }); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.omkooora.com" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "idTeam", "value": "" },
    { "key": "idClub", "value": "" },
    { "key": "idLeague", "value": "" },
    { "key": "idMatch", "value": "" },
    { "key": "idParticipatingTeam", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "description": "Simple liveness probe. Returns { status: \"ok\" }."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "var token = res && res.data && res.data.authenticateUser && res.data.authenticateUser.token;",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "  pm.environment.set('token', token);",
                  "  console.log('Access token saved to {{token}}.');",
                  "} else {",
                  "  console.log('No token in response:', JSON.stringify(res));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($content: loginInfo) {\n  authenticateUser(content: $content) {\n    token\n    user { id role person { id first_name } }\n  }\n}",
                "variables": "{\n  \"content\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
              }
            },
            "description": "Authenticate and receive a short-lived access token. The test script saves it to the `token` variable for every other request."
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query CurrentUser {\n  currentUser { id role person { id first_name second_name } }\n}",
                "variables": "{}"
              }
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "var token = res && res.data && res.data.refreshToken && res.data.refreshToken.token;",
                  "if (token) { pm.collectionVariables.set('token', token); pm.environment.set('token', token); console.log('Token refreshed.'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query RefreshToken {\n  refreshToken { token }\n}",
                "variables": "{}"
              }
            },
            "description": "Reads the httpOnly refresh cookie and mints a new access token. Call this on an UNAUTHENTICATED error, then retry."
          }
        },
        {
          "name": "Log Out",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LogOut {\n  logOut { status }\n}",
                "variables": "{}"
              }
            }
          }
        }
      ]
    },
    {
