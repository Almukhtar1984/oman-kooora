                "query": "mutation CreateTransfer($content: contentTransfer!) {\n  createTransfer(content: $content) {\n    id\n    status\n    type\n    transition_type\n  }\n}",
                "variables": "{\n  \"content\": {\n    \"status\": \"waiting\",\n    \"type\": \"internal\",\n    \"transition_type\": \"loan\",\n    \"id_player\": \"\",\n    \"id_team_from\": \"\",\n    \"id_team_to\": \"\",\n    \"date_start\": \"2026-08-01\",\n    \"date_end\": \"2026-10-01\"\n  }\n}"
              }
